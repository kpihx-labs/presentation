# n8n production environment example
# Fill these values in your real .env file on the server.

N8N_HOST=n8n.kpihx-labs.com
N8N_PORT=5678
N8N_PROTOCOL=https

# Critical: generate once and keep forever.
N8N_ENCRYPTION_KEY=<GENERATE_A_LONG_RANDOM_SECRET>

# Public webhook edge.
WEBHOOK_URL=https://ops-hooks.kpihx-labs.com/

# Reuse an existing Postgres instance with a dedicated database and user.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=<N8N_DB_PASSWORD>

# Optional quality-of-life flags.
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_LOG_LEVEL=info
